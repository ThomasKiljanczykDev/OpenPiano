# Copy to keystore.properties (gitignored) for signed local release builds.
# CI equivalents: RELEASE_KEYSTORE_PATH, RELEASE_KEYSTORE_PASSWORD, RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD.
storeFile=<PLACEHOLDER: absolute path to openpiano-release.jks>
storePassword=<PLACEHOLDER: keystore password>
keyAlias=<PLACEHOLDER: key alias>
keyPassword=<PLACEHOLDER: key password>
